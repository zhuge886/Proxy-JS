#!name=百度网盘每日签到（Surge JS）
#!desc=自动保存网盘请求中的 Cookie；每日 08:30 签到并通知。先阅读 README，安装脚本并配好 MITM。任务中心 App 通道需本账号有效设备参数。

[Script]
Baidu-Cookie = type=http-request,pattern=^https://pan\.baidu\.com/(?:api/|rest/2\.0/|coins/|act/),script-path=https://raw.githubusercontent.com/zhuge886/Proxy-JS/main/Surge/baidu-netdisk.js?v=20261029-2,timeout=5,argument=mode=capture
Baidu-Daily = type=cron,cronexp="30 8 * * *",wake-system=true,script-path=https://raw.githubusercontent.com/zhuge886/Proxy-JS/main/Surge/baidu-netdisk.js?v=20261029-2,timeout=180,argument=mode=run
Baidu-Pending = type=cron,cronexp="*/6 * * * *",wake-system=false,script-path=https://raw.githubusercontent.com/zhuge886/Proxy-JS/main/Surge/baidu-netdisk.js?v=20261029-2,timeout=180,argument=mode=pending
Baidu-Check = type=generic,script-path=https://raw.githubusercontent.com/zhuge886/Proxy-JS/main/Surge/baidu-netdisk.js?v=20261029-2,timeout=180,argument=mode=check
Baidu-Config = type=generic,script-path=https://raw.githubusercontent.com/zhuge886/Proxy-JS/main/Surge/baidu-netdisk-config.js?v=20261029-2,timeout=5

[MITM]
hostname = %APPEND% pan.baidu.com

